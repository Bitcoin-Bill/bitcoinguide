{
  "name": "Access",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "title": "Expires",
      "description": "Null or empty for permanent access"
    }
  },
  "required": [
